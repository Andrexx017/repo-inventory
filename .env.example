POSTGRES_DB=inventory
POSTGRES_USER=admin_inventory
POSTGRES_PASSWORD=

# Clave simétrica para firmar los JWT (HS256) — cualquier cadena aleatoria larga,
# ej. `openssl rand -base64 48`. Debe coincidir con Jwt:Key en
# backend/appsettings.Development.json si corres el backend suelto (fuera de Docker).
JWT_KEY=

# URL de la API que el frontend consume, "horneada" en el build de Vite
# (variable de build, no de runtime — si cambia, hay que reconstruir la imagen).
VITE_API_URL=http://localhost:5107

# Cuenta de Gmail usada para enviar el correo de "recuperar contraseña" (RF de
# login) — requiere verificación en 2 pasos activada y una contraseña de
# aplicación generada en la cuenta (no la contraseña normal de Gmail). Ver
# backend/docs/decisions.md, sección "Recuperación de contraseña".
SMTP_USER=
SMTP_PASSWORD=
