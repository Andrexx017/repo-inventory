<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <!-- Pinned a la misma versión que usa inventory.dll (Microsoft.EntityFrameworkCore.Design,
         PrivateAssets="all", así que su versión no "fluye" hacia este proyecto) — sin esto,
         backend.Tests resuelve una versión más vieja de EF Core (heredada de Npgsql.EntityFrameworkCore.PostgreSQL)
         y falla en tiempo de compilación al usar tipos de EF Core (p. ej. IDbContextTransaction) en los tests. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\backend\inventory.csproj" />
  </ItemGroup>

</Project>